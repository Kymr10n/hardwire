{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check (quality gate)",
      "type": "shell",
      "command": "tools/check.sh",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Run: Steam Deck / PC (1280x800)",
      "type": "shell",
      "command": "godot --path . --resolution 1280x800",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Run: phone portrait (540x960)",
      "type": "shell",
      "command": "godot --path . --resolution 540x960",
      "problemMatcher": []
    },
    {
      "label": "Deploy: Steam Deck",
      "type": "shell",
      "command": "tools/deck.sh",
      "problemMatcher": []
    },
    {
      "label": "Setup",
      "type": "shell",
      "command": "tools/setup.sh",
      "problemMatcher": []
    },
    {
      "label": "Open Godot editor",
      "type": "shell",
      "command": "godot -e --path .",
      "problemMatcher": []
    }
  ]
}
